# Copy this file to .env (same folder as index.html) and fill in real values.
# In cPanel File Manager: enable "Show Hidden Files", right-click .env.example,
# rename it to .env, then edit it.

# Shared passcode your family enters once to get into the app.
FAMILY_CODE=changeme

# Required for AI restaurant/activity suggestions, event & game search,
# and menu-link lookups. Get one at https://console.anthropic.com
# (no free tier — a minimum $5 prepaid credit is required to activate a key).
ANTHROPIC_API_KEY=

# Required for real place photos, ratings, websites, and exact map pins.
# Enable "Places API (New)" and billing on the Google Cloud project this
# key belongs to. Google gives 5,000 free calls/month on this API as of
# 2026 — a family trip app will very likely stay free, but Google still
# requires a card on file to turn billing on at all.
GOOGLE_MAPS_API_KEY=

# Optional, not currently used — reserved for a possible future fallback.
UNSPLASH_ACCESS_KEY=

# Usually fine to leave as-is.
ANTHROPIC_MODEL=claude-sonnet-5
