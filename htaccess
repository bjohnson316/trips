# Never serve the env file, the shared library, or the raw database over HTTP.
<FilesMatch "^(\.env|lib\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Keep the service worker file from being cached too long, so an update to
# it is picked up promptly by returning visitors.
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

DirectoryIndex index.html
